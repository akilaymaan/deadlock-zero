# DeadlockZero server configuration. Copy to .env for local use; .env is git-ignored.
# Every value is optional; the defaults shown here are what the server uses when unset.
# The server needs no API keys, database, or external services.

# Network
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Logging: debug | info | warn | error | silent
LOG_LEVEL=info

# Comma-separated list of allowed cross-origin callers (e.g. https://app.example.com).
# Leave empty to allow same-origin requests only. "*" is rejected.
CORS_ORIGIN=

# Set to true only when running behind a trusted reverse proxy, so rate limiting uses the client IP.
TRUST_PROXY=false

# Per-client rate limit for POST /api/analyze and POST /api/benchmark.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Input limits.
MAX_TRACE_EVENTS=10000
BODY_LIMIT_BYTES=2000000

# Stress-test simulation: default and maximum number of virtual workers.
SIMULATION_WORKERS=500
MAX_SIMULATION_WORKERS=5000
